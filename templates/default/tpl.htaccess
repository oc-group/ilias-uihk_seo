# BEGIN ilias-uihk_seo
# Do not edit manually.
<IfModule mod_rewrite.c>
  RewriteEngine On

  DirectoryIndex Customizing/global/plugins/Services/UIComponent/UserInterfaceHook/Seo/go.php index.php
  ErrorDocument 404 {ILIAS_HTTP_PATH}/404/

  # Avoid rewriting existing files and directories.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Check permalink and rewrite to the plugin. B escapes the captured path
  # (an encoded & stays inside the page value); QSA keeps the visitor's own
  # query string (utm_source, ...) after the permalink parameter.
  RewriteRule (.*) /Customizing/global/plugins/Services/UIComponent/UserInterfaceHook/Seo/go.php?page=$1 [B,QSA,L]
</IfModule>
# END ilias-uihk_seo
