section_languages#:#Sprache
section_languages_info#:#Für welche der installierten Sprachen das Plugin SEO-Metadaten veröffentlicht. Aktivieren Sie eine Sprache, um sie einzuschalten; der Hinweis unter jeder Sprache zählt die Seiten, die bereits Metadaten in dieser Sprache haben.
section_settings#:#Einstellungen
seo#:#SEO
seo_default_language#:#Standardsprache
seo_default_language_info#:#Immer aktiv, unabhängig davon, wie ihr eigenes Kontrollkästchen unten gesetzt ist.
seo_edit#:#SEO-Metadaten bearbeiten
seo_lang_pages_info#:#SEO-Metadaten gespeichert für %s von %s Seiten (%s%%).
sitemap_builder#:#Sitemap-Generator
sitemap_builder_info#:#Erstellt die Website-Sitemap des öffentlichen Bereichs.
sitemap_exclusion#:#Sitemap-Ausschluss
sitemap_status#:#Sitemap-Status
sitemap_status_in_no_date#:#In der Sitemap (kein Datum)
sitemap_status_in_object_date#:#In der Sitemap (Objektdatum)
sitemap_status_in_page_date#:#In der Sitemap (Seitendatum)
sitemap_status_out_lang_inactive#:#Ausgeschlossen (Sprache inaktiv)
sitemap_status_out_no_object#:#Ausgeschlossen (Objekt gelöscht)
sitemap_status_out_noindex#:#Ausgeschlossen (Noindex)
