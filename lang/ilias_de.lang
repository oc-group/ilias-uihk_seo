frequency_info#:#Die Häufigkeit, mit der die Seite aktualisiert wird. Sie gibt Crawlern an, wie oft sie die Seite scannen sollten.
frequency_monthly#:#Monatlich
frequency_never#:#Nie
frequency_weekly#:#Wöchentlich
frequency_yearly#:#Jährlich
homepage_already_exists#:#Eine andere Seite ist bereits als Startseite festgelegt.
homepage_confirm_action#:#Ja, als Startseite verwenden
homepage_confirm_expired#:#Für diese Seite wartet nichts auf Bestätigung. Wenn Sie sie als Startseite festlegen wollten, bearbeiten Sie ihre SEO-Metadaten erneut und lassen Sie den Permalink leer.
homepage_confirm_message#:#"%s" als Startseite Ihrer Website verwenden, ausgeliefert unter der Root-Adresse (z. B. example.com/) statt unter einem Permalink? Es kann jeweils nur eine Seite die Startseite sein.
homepage_confirm_title#:#Als Startseite verwenden
homepage_pending_notice#:#Diese Werte werden nicht gespeichert. Sie haben eine Änderung an der Startseite unbestätigt gelassen; speichern Sie erneut, um zur Bestätigung zurückzukehren, oder geben Sie einen Permalink ein, um sie zu verwerfen.
index#:#Index
index_page#:#Indexieren
index_page_info#:#Gibt an, ob die Seite für Suchmaschinen sichtbar ist (indexiert). Wenn aktiviert, können Sie die Werte für Häufigkeit und Priorität festlegen, die ausschließlich Teil der <b>Sitemap</b> sind.
